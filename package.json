{
  "name": "@rello-platform/signals",
  "version": "0.5.0",
  "description": "Cross-app signal zod schemas + canonical signal-type registry (types/categories/normalizer) + SignalPriority namespace for Rello platform",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schemas/*": {
      "types": "./dist/schemas/*.d.ts",
      "import": "./dist/schemas/*.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test tests/*.test.mjs",
    "prepublishOnly": "npm run build"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/rello-platform/signals.git"
  },
  "license": "UNLICENSED",
  "devDependencies": {
    "@rello-platform/eslint-config": "github:rello-platform/eslint-config#v0.4.0",
    "@types/node": "^25.5.0",
    "eslint": "^9",
    "tsup": "^8.0.0",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "@rello-platform/slugs": "github:rello-platform/slugs#v0.5.0",
    "zod": "^4.3.6"
  }
}
